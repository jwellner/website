{% extends "layout.njk" %}

{% block content %}
  {# Static fallback (SEO, no-JS). The terminal script replaces it. #}
  <div id="vanilla-terminal">
    <div class="item billboard">
      <h1 class="title"><a href="/" class="title-link">Jeroen Wellner</a></h1>
      <p class="tagline">Devops/Software Engineer</p>
    </div>
    <div class="container home">
      {{ content | safe }}
    </div>
    {% for section in collections.section | sort(false, false, 'data.order') %}
      <section class="site-section" data-section data-title="{{ section.data.title }}">
        {{ section.templateContent | safe }}
      </section>
    {% endfor %}
    <noscript>
      <p class="container home">The interactive terminal needs JavaScript. You can mail me at <a href="mailto:{{ site.author }}">{{ site.author }}</a>.</p>
    </noscript>
  </div>
{% endblock %}
